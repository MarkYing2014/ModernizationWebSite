{
  "name": "modernization-website",
  "version": "0.1.0",
  "private": true,
  "description": "AI-Driven Website Modernization Platform",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prepare": "husky install",
    "start": "nx run-many -t serve -p api-gateway,dashboard-web",
    "build": "nx run-many -t build --all",
    "test": "nx run-many -t test --all",
    "lint": "nx run-many -t lint --all",
    "format": "prettier --write \"**/*.{js,ts,tsx,md,json}\"",
    "graph": "nx graph",
    "affected": "nx affected",
    "affected:test": "nx affected -t test",
    "affected:lint": "nx affected -t lint",
    "affected:build": "nx affected -t build",
    "docker:up": "docker compose -f infra/docker-compose.local.yml up -d",
    "docker:down": "docker compose -f infra/docker-compose.local.yml down",
    "clean": "nx reset && rm -rf node_modules"
  },
  "dependencies": {
    "@nx/devkit": "^18.0.0"
  },
  "devDependencies": {
    "@nx/eslint": "^18.0.0",
    "@nx/jest": "^18.0.0",
    "@nx/js": "^18.0.0",
    "@nx/react": "^18.0.0",
    "@nx/workspace": "^18.0.0",
    "@types/jest": "^29.5.5",
    "@types/node": "^20.8.2",
    "@typescript-eslint/eslint-plugin": "^6.7.4",
    "@typescript-eslint/parser": "^6.7.4",
    "eslint": "^8.51.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-import": "^2.28.1",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "lefthook": "^1.5.2",
    "nx": "^18.0.0",
    "prettier": "^3.0.3",
    "ts-jest": "^29.1.1",
    "typescript": "^5.2.2"
  },
  "nx": {
    "tasksRunnerOptions": {
      "default": {
        "runner": "nx/tasks-runners/default",
        "options": {
          "cacheableOperations": [
            "build",
            "lint",
            "test",
            "e2e"
          ],
          "parallel": 3
        }
      }
    },
    "targetDefaults": {
      "build": {
        "dependsOn": [
          "^build"
        ],
        "inputs": [
          "production",
          "^production"
        ]
      },
      "test": {
        "inputs": [
          "default",
          "^production",
          "{workspaceRoot}/jest.preset.js"
        ]
      },
      "lint": {
        "inputs": [
          "default",
          "{workspaceRoot}/.eslintrc.json"
        ]
      }
    }
  }
}
