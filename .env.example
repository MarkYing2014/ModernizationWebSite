# ModernizationWebSite - Environment Variables Example
# Copy this file to .env.local and adjust values for your environment

# Core settings
ENVIRONMENT=development
LOG_LEVEL=DEBUG
DEBUG=true
API_PREFIX=/api

# CORS settings
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database settings
POSTGRES_URL=postgresql://svc:svc@localhost:5432/modernize
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# Redis settings
REDIS_URL=redis://localhost:6379/0
REDIS_POOL_SIZE=10

# JWT settings
JWT_SECRET=your-super-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Neo4j settings
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j

# MinIO / S3 settings
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=localminio
MINIO_SECRET_KEY=localminio123
MINIO_SECURE=false
STORAGE_BUCKET_NAME=modernize-web

# Service endpoints (uncomment and set when services are running)
# SCRAPER_SERVICE_URL=http://localhost:8001
# EXTRACTOR_SERVICE_URL=http://localhost:8002
# ANALYZER_SERVICE_URL=http://localhost:8003
# AI_DESIGN_SERVICE_URL=http://localhost:8004

# Monitoring and observability
# SENTRY_DSN=your-sentry-dsn
PROMETHEUS_METRICS_ENABLED=true

# Rate limiting
RATE_LIMIT_PER_MINUTE=100

# Job queue settings
JOB_QUEUE_NAME=modernize-web:jobs
JOB_RESULT_TTL=86400

# Crawler settings
MAX_CRAWL_DEPTH=10
MAX_CRAWL_PAGES=1000
RESPECT_ROBOTS_TXT=true

# Password security settings
# PASSWORD_PEPPER=your-pepper-value
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4
