# ModernizationWebSite .gitignore
# Comprehensive exclusion patterns for the monorepo

# === Node.js / JavaScript / TypeScript ===
# Dependencies
node_modules/
.pnpm-store/
.npm/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Build outputs
dist/
dist-ssr/
build/
out/
.output/
.nuxt/
.next/
.vite/
storybook-static/

# Testing
coverage/
.nyc_output/
.jest-cache/

# TypeScript
*.tsbuildinfo
.tsc-cache/

# Nx
.nx/
nx-cache/

# === Python ===
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Distribution / packaging
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.env/
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/
.python-version

# pytest
.pytest_cache/
.coverage
htmlcov/

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# === Environment Files ===
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local

# Keep examples
!.env.example

# === IDE / Editors ===
# VSCode
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
!.vscode/launch.json.example
!.vscode/tasks.json.example

# JetBrains IDEs
.idea/
*.iml
*.iws
*.ipr
*.iws
.idea_modules/
out/

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~

# === OS Files ===
# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msm
*.msp
*.lnk

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# === Project Specific ===
# Docker volumes data
volumes/

# Local MinIO data
minio_data/

# Local PostgreSQL data
postgres_data/

# Local Redis data
redis_data/

# Local Neo4j data
neo4j_data/
neo4j_logs/

# Playwright
**/playwright-report/
**/test-results/
**/playwright/.cache/

# Build artifacts
**/target/
**/.turbo/

# Generated files
.generated/
generated/

# Temporary files
.tmp/
tmp/
temp/
*.temp

# Cache
.cache/
.eslintcache
.stylelintcache

# Local certificates
*.pem
*.key
*.crt
